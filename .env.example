# =============================================================================
# Job-Posting QA Dashboard - environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. Every variable has a sensible default - locally you
# only need ANTHROPIC_API_KEY (for the AI review) plus the session secret and
# bootstrap-admin credentials.

# ---- REQUIRED ----------------------------------------------------------------

# Anthropic API key for the AI review layer. Get one at
# https://console.anthropic.com/. The regex/AUTO layer runs fine without it.
ANTHROPIC_API_KEY=sk-ant-...

# Flask session signing key. MUST be set in production. If unset, the app falls
# back to an insecure dev key with a loud warning. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# Bootstrap admin - used on first run only. If the `users` table is empty at
# startup, the app seeds a single admin from these values. Rotate the password
# via the /users page after first login; these are ignored once a user exists.
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=pick-a-strong-password

# ---- DEPLOYMENT CONFIG (optional; defaults match `python qa_dashboard.py`) ---

# Primary database URL. SQLite default derives from APP_DATA_DIR. A
# postgresql+psycopg:// URL is accepted for Alembic migrations today; the
# runtime query layer is still SQLite-dialect (see README "What I'd build next").
# DATABASE_URL=sqlite:////app/data/qa_tickets.db

# Writable data root. Container: /app/data; local: the repo folder.
# APP_DATA_DIR=

# Cached postings JSON. Default: <APP_DATA_DIR>/jobs_raw.json.
# JOBS_RAW_PATH=

# HTTP bind config. Containers set HOST=0.0.0.0; local dev defaults to loopback.
# HOST=127.0.0.1
# PORT=5000

# Flask environment. `production` enables secure-cookie flags.
# FLASK_ENV=development

# SQLite write-safety workaround. Set to 1 only if your DB folder sits on a
# OneDrive / Dropbox / Google-Drive sync path. Off for normal filesystems.
# USE_DB_COPY_WORKAROUND=0

# ---- OPTIONAL TUNING ---------------------------------------------------------

# Minimum seconds between Claude API calls during AI review. Default 13.
# QA_MIN_INTERVAL_SEC=13
