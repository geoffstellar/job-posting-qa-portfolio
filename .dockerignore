# Keep build context small + prevent secrets / local state from leaking
# into the image layer.

# Secrets
.env
.env.*
!.env.example

# SQLite databases - the container creates a fresh DB on first boot in
# /app/data (named volume on compose, persistent volume on Fly). Never ship
# a local dev DB in the image.
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.db.tmp-write
*.db-direct-sentinel

# Runtime artifacts (auto-regenerated by fetch_jobs / run_ai_review)
jobs_raw.json
_last_prompt.txt
_qa_meta.json

# Python build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtualenvs - never rebuild inside the container with host deps
venv/
.venv/
env/
ENV/

# Git + GitHub + CI cruft
.git/
.gitignore
.gitattributes
.github/

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

*.bak
*.bak*

# Documentation that's not needed at runtime. CLAUDE.md + SKILL.md + README
# are developer/portfolio docs, not read by the app. EXCEPTION:
# docs/style_guide.md is read by run_ai_review.py's AI system prompt at
# runtime, so it must stay in the image.
CLAUDE.md
SKILL.md
README.md
docs/
!docs/style_guide.md
*.docx
*.xlsx

# Windows-only launchers
*.bat
