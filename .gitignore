# Secrets — never commit the real .env; .env.example (no values) IS committed.
.env
.env.*
!.env.example

# SQLite databases — machine-local state. seed_demo_data.py rebuilds the demo
# DB on demand; production starts empty and is populated by the pipeline.
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.db.tmp-write
*.bak
*.bak-*

# Runtime artifacts (auto-regenerated by run_ai_review.py)
_last_prompt.txt
_qa_meta.json

# NOTE: jobs_raw.json IS tracked — it's the synthetic demo dataset that
# seed_demo_data.py reads, not live data.

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
ENV/

# Editor / OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
_tmp/
